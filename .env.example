# 複製成 .env.local（已被 .gitignore 擋住）後填入你自己的值。
# 這個檔案只放變數名稱與 placeholder，不放任何真實網址、金鑰或 project ref。

# development | staging | production | test
# 沒有設定時 App 會拒絕啟動 —— 不會自動採用 production。
EXPO_PUBLIC_APP_ENV=

# 專案「根」URL，例如 https://<ref>.supabase.co
# 不要填 /rest/v1、/auth/v1 這類 endpoint，supabase-js 會自己接上。
EXPO_PUBLIC_SUPABASE_URL=

EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 你預期連到的 project ref。development 與 staging 必填，
# 與上面 URL 解析出來的 ref 不一致時 App 會停止連線。
EXPO_PUBLIC_EXPECTED_SUPABASE_PROJECT_REF=

# show | hide | auto（預設 auto）
# hide 只關掉畫面上的標示，環境驗證照跑。
EXPO_PUBLIC_ENV_BADGE_MODE=

EXPO_PUBLIC_GEMINI_API_KEY=
