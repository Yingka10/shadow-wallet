{
  "_meta": {
    "policyVersion": "coin-policy-1.0.0",
    "status": "ACTIVE — 已定案（首版）。調整任一數字時請 bump policyVersion。",
    "source": "docs/coin-policy-draft.md",
    "effectiveDate": "2026-07-22",
    "notes": [
      "第一版只吃 C / D；A / B 由 reward-eligibility 閘門在進入本檔前擋掉。",
      "難度為列舉三值（easy/standard/hard），不用連續小數。",
      "算法為『時間分級 band → baseCoins → 難度加減 → 套 range clamp』，非線性乘法。",
      "6–9 為錨點年齡；4–6 數字較小；9–12 額度較大但單價不外推——年齡差異體現在任務規模與 range 上限，非每分鐘幣值。",
      "每筆任務儲存時記下 policyVersion 供稽核；改數字後 bump 版本。"
    ]
  },

  "timeBands": [
    { "id": "5-10",  "minMinutes": 5,  "maxMinutes": 10 },
    { "id": "11-20", "minMinutes": 11, "maxMinutes": 20 },
    { "id": "21-30", "minMinutes": 21, "maxMinutes": 30 },
    { "id": "31-45", "minMinutes": 31, "maxMinutes": 45 },
    { "id": "46+",   "minMinutes": 46, "maxMinutes": null }
  ],

  "difficultyDelta": {
    "easy": -1,
    "standard": 0,
    "hard": 2
  },

  "payoutBasis": {
    "allowed": ["per_completion", "per_session", "per_milestone", "final_completion"],
    "default": "per_completion"
  },

  "agePolicies": {
    "2-4": {
      "C": { "coinEnabled": false, "reason": "原則上不獨立呈現、不發幣" },
      "D": { "coinEnabled": false, "reason": "原則上不獨立呈現、不發幣" }
    },
    "4-6": {
      "C": {
        "coinEnabled": true,
        "bandBaseCoins": { "5-10": 2, "11-20": 4, "21-30": 6, "31-45": 8, "46+": 10 },
        "range": { "min": 1, "max": 10 },
        "note": "小額成長幣起步"
      },
      "D": {
        "coinEnabled": true,
        "bandBaseCoins": { "5-10": 2, "11-20": 3, "21-30": 5, "31-45": 7, "46+": 9 },
        "range": { "min": 1, "max": 10 },
        "note": "階段性、數字小"
      }
    },
    "6-9": {
      "C": {
        "coinEnabled": true,
        "bandBaseCoins": { "5-10": 5, "11-20": 10, "21-30": 18, "31-45": 25, "46+": 30 },
        "range": { "min": 3, "max": 30 },
        "note": "錨點：中等貢獻→費力貢獻"
      },
      "D": {
        "coinEnabled": true,
        "bandBaseCoins": { "5-10": 6, "11-20": 10, "21-30": 15, "31-45": 20, "46+": 25 },
        "range": { "min": 5, "max": 25 },
        "note": "錨點：練琴 30 分 ≈ 15 幣"
      }
    },
    "9-12": {
      "C": {
        "coinEnabled": true,
        "bandBaseCoins": { "5-10": 6, "11-20": 12, "21-30": 22, "31-45": 32, "46+": 40 },
        "range": { "min": 5, "max": 40 },
        "note": "額度較大；差異在規模與上限，非單價外推"
      },
      "D": {
        "coinEnabled": true,
        "bandBaseCoins": { "5-10": 8, "11-20": 12, "21-30": 18, "31-45": 28, "46+": 40 },
        "range": { "min": 8, "max": 40 },
        "note": "長期作品／專題，額度較大"
      }
    }
  },

  "frequency": {
    "_note": "單任務頻率上限為 P0；全局每日上限屬 family-policy，Phase 2。",
    "defaultClaimPeriod": "day",
    "defaultMaxClaimsPerPeriod": 1
  }
}
