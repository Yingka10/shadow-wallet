      "modelOutput": {
        "status": "suggestions",
        "schemaVersion": 1,
        "summary": "完成標準可以再明確一點，孩子才知道什麼時候算做完。",
        "suggestions": [
          {
            "id": "s1",
            "kind": "clarify_completion",
            "fieldPath": "completionDescription",
            "currentValue": "寫完並收進書包",
            "suggestedValue": "作業本上的題目都寫完、對過一次，然後放進書包",
            "rationale": "「寫完」沒說要不要檢查，孩子和家長可能各有一套認定。",
            "expectedBenefit": "clearer_expectation",
            "confidence": "high"
          },
          {
            "id": "s2",
            "kind": "adjust_session_time",
